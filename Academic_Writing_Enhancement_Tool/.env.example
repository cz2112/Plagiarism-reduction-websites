# ── 基础 ───────────────────────────────────────────────
# PostgreSQL 连接串
DATABASE_URL="postgresql://user:password@localhost:5432/wenqing?schema=public"
# Redis 连接串（BullMQ 任务队列 + 频率限制）
REDIS_URL="redis://localhost:6379"
# 站点对外地址（用于登出跳转、支付回调拼接等）
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ── 会话 ───────────────────────────────────────────────
# iron-session 加密密钥，必须 >=32 位随机字符串
# 生成：openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"

# ── AI 模型（OpenAI 兼容接口）──────────────────────────
# 第一阶段：三档共用同一服务商（同一 KEY / BASE_URL），只按等级切换模型名。
AI_PROVIDER="openai"
AI_API_KEY="sk-xxxx"
AI_API_BASE_URL="https://api.openai.com/v1"
AI_TIMEOUT_MS="30000"

# 按等级路由模型（服务端决定，前端只传 mode，不可传模型名）
# 普通降重：轻量高速模型；深度降重：平衡模型；至尊降重：高质量模型
AI_STANDARD_MODEL="gpt-4o-mini"
AI_DEEP_MODEL="gpt-4o"
AI_PREMIUM_MODEL="gpt-4o"

# 各等级采样温度（等级差异应主要来自模型能力+提示词，温度仅微调）
AI_STANDARD_TEMPERATURE="0.3"
AI_DEEP_TEMPERATURE="0.6"
AI_PREMIUM_TEMPERATURE="0.75"

# 各等级同模型重试次数（不含首次）
AI_STANDARD_MAX_RETRIES="1"
AI_DEEP_MAX_RETRIES="2"
AI_PREMIUM_MAX_RETRIES="2"

# 输出 token 上限（兜底保护，防止长文本超过模型/服务商上限）
AI_MAX_TOKENS="8192"

# 兼容旧配置：未设置上面的分档模型时回退到 AI_MODEL
AI_MODEL="gpt-4o-mini"

# ── 计费 / 验证码 ──────────────────────────────────────
FREE_CHAR_QUOTA="1000"
OTP_EXPIRE_MINUTES="10"
# 可单独设置；未设置时使用 SESSION_SECRET 对验证码做 HMAC
OTP_HASH_SECRET=""
# 仅在应用始终位于可信反向代理后方时开启
TRUST_PROXY_HEADERS="false"

# ── 短信发送（手机号验证码）────────────────────────────
# 留空则开发环境把验证码打印到控制台；生产环境未配置会拒绝发送。
# 目前支持 aliyun（阿里云短信）
SMS_PROVIDER=""
ALIYUN_SMS_ACCESS_KEY_ID=""
ALIYUN_SMS_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME="文清AI"
# 模板变量需为 ${code}
ALIYUN_SMS_TEMPLATE_CODE="SMS_xxxxxxxx"

# ── 微信登录（开放平台「网站应用」，与微信支付是不同的应用）──
# 需在 open.weixin.qq.com 创建网站应用并通过认证（约 300 元/年）。
# 三项都填齐后，前端 NEXT_PUBLIC_WECHAT_LOGIN_ENABLED 设为 true 才会显示按钮。
WECHAT_WEBSITE_APP_ID=""
WECHAT_WEBSITE_APP_SECRET=""
WECHAT_WEBSITE_REDIRECT_URI="https://your-domain.com/api/auth/wechat/callback"
NEXT_PUBLIC_WECHAT_LOGIN_ENABLED="false"

# ── 邮件发送（验证码）──────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@your-domain.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="文清AI <noreply@your-domain.com>"

# ── 微信支付 V3 ────────────────────────────────────────
# 本地可设为 mock；生产环境必须使用 wechat
PAYMENT_MODE="wechat"
WECHAT_APP_ID="wx_xxxx"
WECHAT_MCH_ID="1600000000"
WECHAT_SERIAL_NO="商户证书序列号"
WECHAT_PRIVATE_KEY_PATH="/path/to/apiclient_key.pem"
WECHAT_NOTIFY_URL="https://your-domain.com/api/payment/callback"
# APIv3 密钥（回调解密用，32 位）
WECHAT_APIV3_KEY="your-32-char-apiv3-key"
# 微信支付平台证书路径（回调验签用）
WECHAT_PLATFORM_CERT_PATH="/path/to/wechatpay_platform_cert.pem"

# ── Worker ─────────────────────────────────────────────
# 任务并发数
WORKER_CONCURRENCY="5"
